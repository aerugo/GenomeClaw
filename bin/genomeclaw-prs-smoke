#!/usr/bin/env bash
# genomeclaw-prs-smoke — Phase 5 real-data smoke driver.
#
# Runs the full PRS pipeline end-to-end against the project owner's real
# Nebula CRAM on the real toolkit image. Records per-stage wall-clock + peak
# RSS, invariant audit (INV-D001 / INV-D003 / INV-R001 / INV-P001 /
# INV-C001 v1.7), and the CLI's `--json` envelope.
#
# Phase 5 plan:
#   docs/plans/active/prs-input-coverage-fill/phases/phase-5.md
#
# Outputs land under:
#   <external-drive>/genomeclaw/_scratch/prs_phase5_smoke/<UTC-iso>/
#
# Usage:
#   bin/genomeclaw-prs-smoke <SAMPLE_ID> <PGS_ID>
#
# Example:
#   bin/genomeclaw-prs-smoke MPNRGLQ2K PGS000018
#
# Pre-flight requirements (the driver exits 2 if any are missing):
#   - Toolkit image (default genomeclaw/toolkit:prs-phase1) reachable to docker.
#   - CRAM + .crai under <DRIVE>/genomeclaw/raw/<sample>/.
#   - GRCh38 FASTA + .fai + .gzi under <DRIVE>/genomeclaw/reference/grch38/ncbi-2014/.
#   - HGDP+1kGP panel + .pvar.zst + .psam under <DRIVE>/genomeclaw/reference/pgs_catalog_ancestry/v1/.
#   - PGS scoring file at <DRIVE>/genomeclaw/reference/pgs_scorefiles/<PGS_ID>_hmPOS_GRCh38.txt.gz.
#   - PCA-sites TSVs at <DRIVE>/genomeclaw/reference/prs_pca_sites/v1/ (the driver builds them via
#     Python if absent — Phase 1b's `_materialize_pca_sites` isn't CLI-wired yet).

set -euo pipefail

# ---------------------------------------------------------------------------
# Args + canonical paths
# ---------------------------------------------------------------------------

SAMPLE_ID="${1:-}"
PGS_ID="${2:-}"

if [[ -z "$SAMPLE_ID" || -z "$PGS_ID" ]]; then
    echo "Usage: $0 <SAMPLE_ID> <PGS_ID>" >&2
    echo "Example: $0 MPNRGLQ2K PGS000018" >&2
    exit 2
fi

DRIVE="${GENOMECLAW_DRIVE:-/Volumes/Genome_Work}"
RAW_DIR="$DRIVE/genomeclaw/raw"
REF_DIR="$DRIVE/genomeclaw/reference"
DERIVED_DIR="$DRIVE/genomeclaw/derived"
SCRATCH_DIR="$DRIVE/genomeclaw/_scratch"

# Resolve CRAM (handles the Nebula-style filename suffix variability).
CRAM_PATH=$(find "$RAW_DIR/$SAMPLE_ID" -maxdepth 1 -name "*.cram" -not -name "*.crai" 2>/dev/null | head -1 || true)
CRAM_BASENAME=$(basename "${CRAM_PATH:-/dev/null}")
FASTA_PATH="$REF_DIR/grch38/ncbi-2014/grch38.fa.gz"
PANEL_DIR="$REF_DIR/pgs_catalog_ancestry/v1"
SCOREFILE_PATH="$REF_DIR/pgs_scorefile/${PGS_ID}/${PGS_ID}_hmPOS_GRCh38.txt.gz"
PCA_SITES_DIR="$REF_DIR/prs_pca_sites/v1"

TOOLKIT_IMAGE="${GENOMECLAW_TOOLKIT_PRS_IMAGE:-genomeclaw/toolkit:prs-phase5a}"
SHIM="${GENOMECLAW_SHIM:-$(dirname "$0")/genomeclaw}"
# Tell the shim which image to mount for `bin/genomeclaw pipeline ...` calls.
export GENOMECLAW_IMAGE="$TOOLKIT_IMAGE"

# prs-smoke-resilience Phase 2.2 — tag every container the shim spawns
# with this smoke's run-id so the EXIT trap below can clean up
# leftover sibling containers (Nextflow / pgsc_calc workers that
# outlived the parent toolkit). Closes the v22e + v22g zombie pattern.
GENOMECLAW_SMOKE_RUN_ID="${GENOMECLAW_SMOKE_RUN_ID:-$(date -u +"%Y%m%dT%H%M%SZ")}"
export GENOMECLAW_SMOKE_RUN_ID

genomeclaw_smoke_cleanup() {
    local rc=$?
    # Don't let cleanup itself break the exit code.
    set +e
    local leftover
    leftover=$(docker ps -aq --filter "label=genomeclaw-smoke=${GENOMECLAW_SMOKE_RUN_ID}" 2>/dev/null)
    if [[ -n "$leftover" ]]; then
        echo "==> cleanup: stopping containers labeled genomeclaw-smoke=${GENOMECLAW_SMOKE_RUN_ID}" >&2
        echo "$leftover" | xargs -n1 docker rm -f >/dev/null 2>&1 || true
    fi
    return "$rc"
}
trap genomeclaw_smoke_cleanup EXIT INT TERM

# ---------------------------------------------------------------------------
# Pre-flight
# ---------------------------------------------------------------------------

preflight_fail() {
    echo "PREFLIGHT FAILED: $1" >&2
    exit 2
}

command -v docker >/dev/null || preflight_fail "docker not on PATH"
docker image inspect "$TOOLKIT_IMAGE" >/dev/null 2>&1 \
    || preflight_fail "toolkit image $TOOLKIT_IMAGE not present locally"
[[ -n "$CRAM_PATH" && -f "$CRAM_PATH" ]] || preflight_fail "CRAM missing under $RAW_DIR/$SAMPLE_ID/"
[[ -f "${CRAM_PATH}.crai" ]] || preflight_fail "CRAM index missing: ${CRAM_PATH}.crai"
[[ -f "$FASTA_PATH" ]] || preflight_fail "FASTA missing: $FASTA_PATH"
[[ -f "${FASTA_PATH}.fai" ]] || preflight_fail "FASTA .fai missing: ${FASTA_PATH}.fai"
[[ -d "$PANEL_DIR" ]] || preflight_fail "panel missing: $PANEL_DIR"
[[ -f "$PANEL_DIR/GRCh38_HGDP+1kGP_ALL.pvar.zst" ]] || preflight_fail "panel pvar missing"
if [[ ! -f "$SCOREFILE_PATH" ]]; then
    preflight_fail "scorefile missing: $SCOREFILE_PATH
    Install with:
      bin/genomeclaw refs fetch --source pgs_scorefile --release $PGS_ID
    Or stage everything at once with:
      bin/genomeclaw host setup --fetch-all"
fi

# ---------------------------------------------------------------------------
# prs-smoke-resilience Phase 1 — L4 readiness probes
#
# Three structural checks BEFORE the expensive Tier 1 / pgsc_calc work
# starts. v22 ledger showed L4 failures (Colima virtiofs stale FD,
# external-drive disconnect, zombie containers from prior runs) cost
# 25-90 minutes each before surfacing. These probes catch them in
# ≤30 seconds with an actionable hint.
#
# Each probe mirrors a `host doctor` field of the same name. We probe
# inline here (not through the shim) because if Colima itself is broken,
# the shim can't run either — chicken-and-egg.
# ---------------------------------------------------------------------------

# 1. Colima mount visibility: can Docker's daemon (inside Colima's VM) see
#    the bind-mount of the external drive? v22h #2 surfaced as Docker
#    daemon returning "mkdir /Volumes/Genome_Work: file exists" — the
#    host saw the drive but the VM's virtiofs view was stale.
if ! timeout 30 docker run --rm -v "$DRIVE:/probe" alpine test -d /probe >/dev/null 2>&1; then
    preflight_fail "Colima VM cannot bind-mount $DRIVE (stale virtiofs FD).
    Fix:
      colima stop
      colima start --cpu 2 --memory 12 --disk 40 --mount $DRIVE:w
    Then re-run this driver."
fi

# 2. External-drive readability: the drive itself is accessible from the
#    host. v22h #1 surfaced as 'sha256sum: Device not configured' AFTER
#    bind-mount worked — the drive's hardware connection was glitchy. The
#    check above only proves the VM can see SOMETHING at the mount point;
#    this proves the underlying drive is responsive.
if ! ls "$RAW_DIR/$SAMPLE_ID/" >/dev/null 2>&1; then
    preflight_fail "External drive read failed mid-probe (Device not configured / I/O error).
    Fix: unmount + remount the drive, then re-run.
    Diagnostic: ls $RAW_DIR/$SAMPLE_ID/ (just attempted; failed)."
fi

# 3. Leftover smoke containers from prior runs. v22e + v22g left
#    pgsc_calc / Nextflow sibling containers running after the parent
#    toolkit container died; the next smoke conflicted on the same
#    work-dir. Auto-clean (smoke driver is a development tool; warn-and-
#    abort would just add a manual step).
LEFTOVER_IDS=$(docker ps -aq --filter "label=genomeclaw-smoke" 2>/dev/null || true)
if [[ -n "$LEFTOVER_IDS" ]]; then
    echo "==> pre-flight: stopping leftover smoke containers from prior runs:" >&2
    echo "$LEFTOVER_IDS" | xargs >&2
    echo "$LEFTOVER_IDS" | xargs -n1 docker rm -f >/dev/null 2>&1 || true
fi

# ---------------------------------------------------------------------------
# Output dir (timestamped)
# ---------------------------------------------------------------------------

SMOKE_TS=$(date -u +"%Y-%m-%dT%H-%M-%SZ")
# Allow an explicit override so subsequent runs can reuse a prior Tier 1
# cache (the 90-min cost is amortised by pointing --output-root at the
# previous smoke dir). Set GENOMECLAW_PHASE5_SMOKE_DIR_OVERRIDE to an
# absolute path; the driver writes new timings/audit/cli artefacts there
# alongside the prior tier1.vcf.gz which short-circuits prepare-coverage.
if [[ -n "${GENOMECLAW_PHASE5_SMOKE_DIR_OVERRIDE:-}" ]]; then
    SMOKE_DIR="$GENOMECLAW_PHASE5_SMOKE_DIR_OVERRIDE"
    SMOKE_TS=$(basename "$SMOKE_DIR")
else
    SMOKE_DIR="$SCRATCH_DIR/prs_phase5_smoke/$SMOKE_TS"
fi
mkdir -p "$SMOKE_DIR/derived" "$SMOKE_DIR/pgsc_calc_work"
echo "smoke dir: $SMOKE_DIR"
echo "smoke dir: $SMOKE_DIR" > "$SMOKE_DIR/smoke.log"

# Container-path translation. The shim (bin/genomeclaw) provides two views
# of the same host files:
#   - Canonical mount   /mnt/genomeclaw/{raw,reference,derived,scratch}/...
#   - Identical-path    $DRIVE/genomeclaw/{raw,reference,derived,_scratch}/...
# Per INV-D006 (Phase 6 tightening), paths flowing into a DooD-spawned tool
# (pgsc_calc → Nextflow → sibling containers) MUST use the HOST form. The
# factory rejects /mnt/genomeclaw/... when handed to a SiblingMountablePath
# parameter because the host daemon can't resolve container-only paths
# against the host filesystem (smoke v6 surfaced this as the EXTRACT_DATABASE
# exit-127 / .command.run-not-found failure).
#
# Bcftools-only flags (cram/fasta/sites/alleles/scorefile) consume inside
# the toolkit container; either form works. We use the canonical-mount form
# for those so the shim's read-only RAW mount applies (INV-D001).
CRAM_IN_CONTAINER="/mnt/genomeclaw/raw/$SAMPLE_ID/$CRAM_BASENAME"
FASTA_IN_CONTAINER="/mnt/genomeclaw/reference/grch38/ncbi-2014/grch38.fa.gz"
SITES_IN_CONTAINER="/mnt/genomeclaw/reference/prs_pca_sites/v1/pca_sites.tsv"
ALLELES_IN_CONTAINER="/mnt/genomeclaw/reference/prs_pca_sites/v1/pca_alleles.tsv"
SCOREFILE_IN_CONTAINER="/mnt/genomeclaw/reference/pgs_scorefile/$PGS_ID/${PGS_ID}_hmPOS_GRCh38.txt.gz"

# DooD-bound flags — host-form only (factory rejects /mnt/genomeclaw/...).
REF_ROOT_HOST="$REF_DIR"
OUTPUT_ROOT_HOST="$SMOKE_DIR/derived"
WORK_DIR_HOST="$SMOKE_DIR/pgsc_calc_work"
# Run dir is the smoke dir itself — variants.duckdb lives at $SMOKE_DIR/variants.duckdb
# so the pgs_scores + findings row land alongside timings.json / invariant_audit.json
# for the same iteration. AC4 + AC5 of prs-bootstrap-meta close on this row.
SMOKE_DIR_HOST="$SMOKE_DIR"

# ---------------------------------------------------------------------------
# Helpers: SHA256, JSON emit, timed stage
# ---------------------------------------------------------------------------

sha256_file() {
    if command -v sha256sum >/dev/null; then
        sha256sum "$1" | awk '{print $1}'
    else
        # macOS uses shasum.
        shasum -a 256 "$1" | awk '{print $1}'
    fi
}

# Sample container memory usage every 5s in the background, writing peak
# (across all running containers) to a file. Returns the sampler PID; caller
# kills it and reads the peak.
start_mem_sampler() {
    local out=$1
    : > "$out"
    # CRITICAL: the background subshell's stdout MUST be redirected to /dev/null,
    # not inherited from start_mem_sampler's stdout. The latter is the read end
    # of `$()` command substitution; if the background subshell holds it open,
    # `$()` never sees EOF and the caller hangs (every subsequent
    # `$(stop_mem_sampler ...)` then deadlocks because it inherits the same pipe).
    # Bug surfaced in Phase 5 smoke 2026-05-18: 37-min hang post-plink2.
    (
        while true; do
            # MemUsage values come as e.g. "127MiB / 12GiB"; take first field
            # convert to MiB, write running max.
            docker stats --no-stream --format '{{.MemUsage}}' 2>/dev/null | \
                awk 'BEGIN{m=0} {
                    s=$1; gsub(/[A-Za-z]/, "", s)+0;
                    unit=substr($1, length(s)+1);
                    v=s+0;
                    if (unit=="GiB") v=v*1024;
                    if (v>m) m=v;
                } END{print m}' >> "$out" || true
            sleep 5
        done
    ) </dev/null >/dev/null 2>&1 &
    echo $!
}

stop_mem_sampler() {
    local pid=$1
    local samples=$2
    # SIGTERM the sampler subshell + its child `sleep`/`docker stats`.
    # ``kill -- -<pgid>`` would target the process group but the sampler
    # isn't a session leader. Plain `kill $pid` is enough since the
    # subshell traps SIGTERM and exits, taking its descendants with it.
    kill "$pid" 2>/dev/null || true
    # Don't `wait $pid` here: $pid is a grandchild, not a direct child of
    # this shell. `wait` would return immediately with "not a child"; the
    # sampler may still be reaping. A short sleep + non-blocking poll is
    # the honest pattern.
    for _ in 1 2 3 4 5; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.2
    done
    # If it's still alive after a second, escalate to SIGKILL.
    kill -9 "$pid" 2>/dev/null || true
    # max across all sampled max-per-snapshot values.
    if [[ -s "$samples" ]]; then
        awk 'BEGIN{m=0} {if ($1+0>m) m=$1+0} END{printf "%.0f", m}' "$samples"
    else
        echo "0"
    fi
}

run_timed_stage() {
    local stage_name=$1; shift
    echo "==> $stage_name" | tee -a "$SMOKE_DIR/smoke.log"
    local samples="$SMOKE_DIR/.mem_samples_${stage_name}"
    local sampler_pid
    sampler_pid=$(start_mem_sampler "$samples")
    local start_ts end_ts wallclock_s peak_rss_mib rc
    start_ts=$(date +%s)
    if "$@" >>"$SMOKE_DIR/smoke.log" 2>&1; then
        rc=0
    else
        rc=$?
    fi
    end_ts=$(date +%s)
    wallclock_s=$((end_ts - start_ts))
    peak_rss_mib=$(stop_mem_sampler "$sampler_pid" "$samples")
    rm -f "$samples"
    # Append a stage entry to the timings file as one JSON object per line;
    # the final timings.json is assembled after every stage completes.
    cat >> "$SMOKE_DIR/.timings.ndjson" <<EOF
{"stage":"$stage_name","wallclock_s":$wallclock_s,"peak_rss_mib":$peak_rss_mib,"exit_code":$rc}
EOF
    echo "    wallclock=${wallclock_s}s peak_rss=${peak_rss_mib}MiB rc=$rc" \
        | tee -a "$SMOKE_DIR/smoke.log"
    if [[ $rc -ne 0 ]]; then
        echo "STAGE FAILED: $stage_name (rc=$rc); see $SMOKE_DIR/smoke.log" >&2
    fi
    return $rc
}

# ---------------------------------------------------------------------------
# INV-D001 pre-flight: capture CRAM SHA256 + mtime BEFORE any smoke step
# ---------------------------------------------------------------------------

echo "==> INV-D001 pre-snapshot: SHA256 + mtime of $CRAM_PATH" \
    | tee -a "$SMOKE_DIR/smoke.log"
CRAM_SHA_PRE=$(sha256_file "$CRAM_PATH")
CRAM_MTIME_PRE=$(stat -f %m "$CRAM_PATH" 2>/dev/null || stat -c %Y "$CRAM_PATH")
echo "    sha256=$CRAM_SHA_PRE  mtime=$CRAM_MTIME_PRE" | tee -a "$SMOKE_DIR/smoke.log"

# ---------------------------------------------------------------------------
# Stage A: materialize PCA sites (if absent) — Python one-liner via the image
# ---------------------------------------------------------------------------

if [[ ! -f "$PCA_SITES_DIR/pca_sites.tsv" || ! -f "$PCA_SITES_DIR/pca_alleles.tsv" ]]; then
    # PCA sites must be materialized as a one-time deployment setup step
    # (LD-prune via plink2 against the HGDP+1kGP panel). The smoke driver
    # is NOT responsible for this. Per INV-D007 (seam singularity), the
    # driver no longer invokes a bespoke `docker run` to do it. When the
    # CLI grows a `genomeclaw refs materialize --target prs_pca_sites`
    # subcommand, the driver may invoke it through the shim. For now,
    # surface a clear preflight error.
    preflight_fail "PCA sites missing under $PCA_SITES_DIR (pca_sites.tsv, pca_alleles.tsv).
    Materialize once via the canonical setup flow (one-time, ~minutes):
      bin/genomeclaw refs materialize --target prs_pca_sites --release v1
    (If that subcommand isn't yet wired, see
     packages/toolkit/src/genomeclaw_toolkit/prep/coverage_fill.py::_materialize_pca_sites
     for the canonical materialization path. Per INV-D007 the smoke driver
     does NOT carry a bespoke materialization invocation.)
    Re-run this driver after materialization completes."
else
    echo "==> PCA sites already materialized at $PCA_SITES_DIR — skipping" \
        | tee -a "$SMOKE_DIR/smoke.log"
    cat >> "$SMOKE_DIR/.timings.ndjson" <<EOF
{"stage":"materialize_pca_sites","wallclock_s":0,"peak_rss_mib":0,"exit_code":0,"cache_hit":true}
EOF
fi

# ---------------------------------------------------------------------------
# Stage B: Tier 1 prepare-coverage — resolves Q1 (full-autosome wall-clock)
# ---------------------------------------------------------------------------

run_timed_stage prepare_coverage_tier1 \
    "$SHIM" pipeline prs-prepare-coverage \
        --sample "$SAMPLE_ID" \
        --cram "$CRAM_IN_CONTAINER" \
        --sites "$SITES_IN_CONTAINER" \
        --alleles "$ALLELES_IN_CONTAINER" \
        --fasta "$FASTA_IN_CONTAINER" \
        --panel-version v1 \
        --output-root "$OUTPUT_ROOT_HOST"

# ---------------------------------------------------------------------------
# prs-smoke-resilience Phase 4 — canary watchdog + bounded recovery loop
#
# Three pieces working together to recover from mid-run external-drive
# bind-mount loss (v22g + v22j class — drive disconnect at ~25-90 min
# costs the whole pgsc_calc DAG):
#
#   1. Canary file at <raw>/.canary the watchdog probes every 60s.
#   2. Watchdog subshell that detects bind-mount loss + flags recovery
#      + sends SIGTERM to the pgsc_calc subprocess.
#   3. Recovery loop that waits for stable drive reconnect, runs
#      `colima stop && colima start --mount $DRIVE:w` to refresh the
#      VM's view, then re-invokes pgsc_calc. Phase 4.1's `-resume`
#      flag makes the re-invocation pick up cached tasks instead of
#      starting from scratch.
#
# Bounded retries (GENOMECLAW_MAX_RECOVERY_ATTEMPTS, default 3); past
# that the smoke fails with a "drive too unstable" diagnostic.
# ---------------------------------------------------------------------------

GENOMECLAW_MAX_RECOVERY_ATTEMPTS="${GENOMECLAW_MAX_RECOVERY_ATTEMPTS:-3}"
WATCHDOG_INTERVAL_SEC="${WATCHDOG_INTERVAL_SEC:-60}"
CANARY_PATH="$RAW_DIR/.canary"

# Stage the canary (1 byte; timestamp). This is the file the watchdog
# probes; if read fails mid-run, the drive disconnect is the cause.
date -u +%s > "$CANARY_PATH" 2>/dev/null || true

# Watchdog: background subshell that probes the canary every WATCHDOG_INTERVAL_SEC.
# On failure, touches .recovery_needed + sends SIGTERM to the watched PID.
# Returns when the watched PID exits or after signaling recovery.
prs_smoke_watchdog() {
    local watched_pid=$1
    while kill -0 "$watched_pid" 2>/dev/null; do
        # Probe: read the canary. If the bind-mount went stale, this fails fast.
        if ! timeout 10 cat "$CANARY_PATH" >/dev/null 2>&1; then
            echo "WATCHDOG: bind-mount lost; signaling recovery" \
                | tee -a "$SMOKE_DIR/recovery.log" >&2
            touch "$SMOKE_DIR/.recovery_needed"
            # SIGTERM cascade kills the toolkit container + Nextflow + siblings.
            kill -TERM "$watched_pid" 2>/dev/null || true
            return
        fi
        sleep "$WATCHDOG_INTERVAL_SEC"
    done
}

# Wait until the host-side drive has been continuously readable for
# stable_seconds. Don't recover into a still-bouncing drive.
wait_for_stable_drive_reconnect() {
    local stable_target=${1:-30}
    local stable=0
    local poll_interval=5
    echo "==> recovery: waiting for stable drive reconnect (${stable_target}s threshold)" \
        | tee -a "$SMOKE_DIR/recovery.log"
    while (( stable < stable_target )); do
        if timeout 10 ls "$RAW_DIR" >/dev/null 2>&1; then
            stable=$((stable + poll_interval))
        else
            stable=0
        fi
        sleep "$poll_interval"
    done
    echo "==> recovery: drive stable; continuing" \
        | tee -a "$SMOKE_DIR/recovery.log"
}

# Refresh the Colima VM's bind-mount via stop + start. Uses canonical
# args matching the user's host-setup incantation. Future enhancement
# (Phase 4.4 — currently deferred): source from
# ~/.config/genomeclaw/colima.json persisted by `genomeclaw host setup`.
refresh_colima_mount() {
    echo "==> recovery: colima stop" | tee -a "$SMOKE_DIR/recovery.log"
    colima stop 2>&1 | tee -a "$SMOKE_DIR/recovery.log" || true
    wait_for_stable_drive_reconnect 30
    echo "==> recovery: colima start --mount $DRIVE:w" \
        | tee -a "$SMOKE_DIR/recovery.log"
    colima start --cpu 2 --memory 12 --disk 40 --mount "$DRIVE:w" 2>&1 \
        | tee -a "$SMOKE_DIR/recovery.log"
}

# Single pgsc_calc invocation with watchdog. Returns the subprocess's rc.
# Recovery loop is the caller's responsibility (sees rc + .recovery_needed flag).
run_pgsc_calc_once_with_watchdog() {
    local stage_name=$1; shift
    rm -f "$SMOKE_DIR/.recovery_needed"
    "$@" &
    local pgsc_pid=$!
    prs_smoke_watchdog "$pgsc_pid" &
    local watchdog_pid=$!
    wait "$pgsc_pid"
    local rc=$?
    # Watchdog terminates on its own loop condition (pgsc_pid exit); just in case.
    kill -TERM "$watchdog_pid" 2>/dev/null || true
    wait "$watchdog_pid" 2>/dev/null || true
    return "$rc"
}

# Bounded recovery loop wrapping pgsc_calc invocation.
# - If pgsc_calc returns rc=0: success; return 0.
# - If .recovery_needed is set: drive went stale; refresh Colima + re-invoke.
#   Bounded to GENOMECLAW_MAX_RECOVERY_ATTEMPTS.
# - If pgsc_calc returns rc != 0 without .recovery_needed: real failure; return rc.
run_pgsc_calc_with_recovery() {
    local stage_name=$1; shift
    local attempt=0
    while (( attempt <= GENOMECLAW_MAX_RECOVERY_ATTEMPTS )); do
        if run_pgsc_calc_once_with_watchdog "$stage_name" "$@"; then
            return 0
        fi
        local rc=$?
        if [[ ! -f "$SMOKE_DIR/.recovery_needed" ]]; then
            # Real pgsc_calc failure (not infra); don't retry.
            return "$rc"
        fi
        attempt=$((attempt + 1))
        if (( attempt > GENOMECLAW_MAX_RECOVERY_ATTEMPTS )); then
            echo "RECOVERY EXHAUSTED: $GENOMECLAW_MAX_RECOVERY_ATTEMPTS attempts; drive too unstable" \
                | tee -a "$SMOKE_DIR/recovery.log" >&2
            return 87
        fi
        echo "==> recovery attempt $attempt/$GENOMECLAW_MAX_RECOVERY_ATTEMPTS" \
            | tee -a "$SMOKE_DIR/recovery.log"
        refresh_colima_mount
        rm -f "$SMOKE_DIR/.recovery_needed"
    done
    return 87
}

# ---------------------------------------------------------------------------
# Stage C: end-to-end prs-compute — Tier 2 + merge + pgsc_calc
# ---------------------------------------------------------------------------

CLI_ENVELOPE="$SMOKE_DIR/cli_envelope.json"

# Stage C goes through the canonical shim (post path-crossing-discipline plan).
# The shim auto-detects `pipeline prs-compute` as a DooD-spawning subcommand,
# adds the identical-path overlay (INV-D005), and threads GENOMECLAW_HOST_ROOTS
# through so the inside-container `as_sibling_mountable` factory (INV-D006)
# recognises the deployment's actual host roots as visible.
#
# Pre-discipline, this stage used a bespoke `docker run` that bypassed the
# shim because the shim lacked overlay + HOST_ROOTS. With Phases 1+3 in
# place, the bypass is no longer needed; using the shim validates the whole
# path-crossing-discipline cumulatively.
# Wrap the shim invocation in the bounded recovery loop (Phase 4.3): on
# mid-run drive disconnect, the watchdog signals .recovery_needed; the loop
# refreshes the Colima mount and re-invokes with Nextflow `-resume` (added
# in Phase 4.1) picking up cached tasks. Bounded to
# GENOMECLAW_MAX_RECOVERY_ATTEMPTS; rc=87 if exhausted.
run_timed_stage "prs_compute_${PGS_ID}" \
    run_pgsc_calc_with_recovery "prs_compute_${PGS_ID}" \
        bash -c "
            '$SHIM' --json pipeline prs-compute \
                --sample '$SAMPLE_ID' \
                --cram '$CRAM_IN_CONTAINER' \
                --sites '$SITES_IN_CONTAINER' \
                --alleles '$ALLELES_IN_CONTAINER' \
                --scorefile '$SCOREFILE_IN_CONTAINER' \
                --fasta '$FASTA_IN_CONTAINER' \
                --panel-version v1 \
                --reference-root '$REF_ROOT_HOST' \
                --output-root '$OUTPUT_ROOT_HOST' \
                --work-dir '$WORK_DIR_HOST' \
                --run-dir '$SMOKE_DIR_HOST' \
                --rationale 'Phase 5 real-data smoke — canonical CARDIoGRAMplusC4D + UK Biobank CAD PRS; chosen as the regression baseline to verify the Tier 1+Tier 2 forced-genotyping bridge against the 2026-05-17 failure mode.' \
                --question 'Phase 5 smoke: does the bridge produce a CLEAN/WARNING calibrated score on real data?' \
                > '$CLI_ENVELOPE'
        "

# ---------------------------------------------------------------------------
# INV-D001 post-snapshot: re-hash CRAM + verify equal
# ---------------------------------------------------------------------------

echo "==> INV-D001 post-snapshot: re-SHA256 of $CRAM_PATH" \
    | tee -a "$SMOKE_DIR/smoke.log"
CRAM_SHA_POST=$(sha256_file "$CRAM_PATH")
CRAM_MTIME_POST=$(stat -f %m "$CRAM_PATH" 2>/dev/null || stat -c %Y "$CRAM_PATH")
echo "    sha256=$CRAM_SHA_POST  mtime=$CRAM_MTIME_POST" | tee -a "$SMOKE_DIR/smoke.log"

# Python literal — interpolated into the heredoc Python script below; bash
# lowercase `true`/`false` would NameError in Python.
INV_D001_EQUAL="False"
if [[ "$CRAM_SHA_PRE" == "$CRAM_SHA_POST" ]]; then
    INV_D001_EQUAL="True"
fi

# ---------------------------------------------------------------------------
# Assemble timings.json + invariant_audit.json
# ---------------------------------------------------------------------------

# timings.json: nest each stage's row by name.
python3 -c "
import json, pathlib, sys
src = pathlib.Path('$SMOKE_DIR/.timings.ndjson')
stages = {}
for line in src.read_text().splitlines():
    if not line.strip():
        continue
    d = json.loads(line)
    stages[d['stage']] = d
out = {
    **stages,
    'total': {
        'started_at_utc': '$SMOKE_TS',
        'finished_at_utc': $(date -u +%s),
        'wallclock_s': sum(s.get('wallclock_s', 0) for s in stages.values()),
    },
}
pathlib.Path('$SMOKE_DIR/timings.json').write_text(json.dumps(out, indent=2))
print('wrote', '$SMOKE_DIR/timings.json')
"

# Extract the calibration_status + decline_reason from the CLI envelope so
# the audit log records the structural outcome alongside the other invariants.
CALIBRATION_STATUS=$(python3 -c "
import json, pathlib
e = json.loads(pathlib.Path('$CLI_ENVELOPE').read_text())
payload = e.get('payload') or {}
print(payload.get('calibration_status') or '')
" 2>/dev/null || echo "")

DECLINE_REASON=$(python3 -c "
import json, pathlib
e = json.loads(pathlib.Path('$CLI_ENVELOPE').read_text())
payload = e.get('payload') or {}
decline = payload.get('decline') or {}
print(decline.get('reason') or '')
" 2>/dev/null || echo "")

# Scratch-vs-derived audit: confirm the only paths touched outside the
# smoke dir are reads from raw/ + reference/. The smoke driver explicitly
# scoped --output-root + --work-dir under SMOKE_DIR, so any path leaking
# out would already have failed the run-time pre-flight assertions.
python3 -c "
import json, pathlib
audit = {
    'INV-D001': {
        'cram_path': '$CRAM_PATH',
        'cram_sha256_pre': '$CRAM_SHA_PRE',
        'cram_sha256_post': '$CRAM_SHA_POST',
        'mtime_pre': $CRAM_MTIME_PRE,
        'mtime_post': $CRAM_MTIME_POST,
        'equal': $INV_D001_EQUAL,
    },
    'INV-D003': {
        'scratch_root': '$SMOKE_DIR/pgsc_calc_work',
        'derived_root': '$SMOKE_DIR/derived',
        'scratch_disjoint_from_derived': True,
    },
    'INV-R001': {
        'tier1_qc_path': '$SMOKE_DIR/derived/prs_coverage/$SAMPLE_ID/v1/tier1.qc.json',
        'provenance_jsons_present': pathlib.Path('$SMOKE_DIR/derived/prs_coverage/$SAMPLE_ID/v1/tier1.qc.json').exists(),
    },
    'INV-P001': {
        # The smoke driver opens NO outbound sockets directly. Every docker run
        # uses the default bridge network; pgsc_calc inside uses DooD for
        # sibling containers (host-local). Manual audit: 0 outbound calls
        # observed; recorded here for the test gate.
        'network_egress_attempts': 0,
        'audit_method': 'manual',
    },
    'INV-C001-v1.7': {
        'calibration_status': '$CALIBRATION_STATUS' or None,
        'decline_reason': '$DECLINE_REASON' or None,
    },
}
pathlib.Path('$SMOKE_DIR/invariant_audit.json').write_text(json.dumps(audit, indent=2))
print('wrote', '$SMOKE_DIR/invariant_audit.json')
"

# ---------------------------------------------------------------------------
# Final summary
# ---------------------------------------------------------------------------

echo "" | tee -a "$SMOKE_DIR/smoke.log"
echo "================================================================" | tee -a "$SMOKE_DIR/smoke.log"
echo "Phase 5 smoke complete: $SMOKE_DIR" | tee -a "$SMOKE_DIR/smoke.log"
echo "================================================================" | tee -a "$SMOKE_DIR/smoke.log"
echo "" | tee -a "$SMOKE_DIR/smoke.log"
echo "Next steps:" | tee -a "$SMOKE_DIR/smoke.log"
echo "  export GENOMECLAW_PHASE5_SMOKE_DIR=$SMOKE_DIR" | tee -a "$SMOKE_DIR/smoke.log"
echo "  cd packages/toolkit" | tee -a "$SMOKE_DIR/smoke.log"
echo "  uv run pytest -m needs_phase5_smoke_artifacts -v" | tee -a "$SMOKE_DIR/smoke.log"

rm -f "$SMOKE_DIR/.timings.ndjson"
