#!/usr/bin/env bash
# genomeclaw — host shim that delegates to the genomeclaw/toolkit image.
#
# Usage:
#   genomeclaw <group> <verb> [args...]      # canonical (after rich-cli)
#
# Environment knobs:
#   GENOMECLAW_IMAGE        Image reference (default: genomeclaw/toolkit:dev)
#   GENOMECLAW_RAW_DIR      Host path bind-mounted at /mnt/genomeclaw/raw (RO)
#   GENOMECLAW_REF_DIR      Host path bind-mounted at /mnt/genomeclaw/reference
#                           (RO at runtime; RW only during `refs fetch`)
#   GENOMECLAW_DERIVED_DIR  Host path bind-mounted at /mnt/genomeclaw/derived (RW)
#   GENOMECLAW_SCRATCH_DIR  Host path bind-mounted at /mnt/genomeclaw/scratch (RW)
#                           Ephemeral scratch — temp / sort-temp / DuckDB
#                           spill / Nextflow `work/`. Nothing inside is
#                           authoritative; safe to delete between runs.
#
#   When the four *_DIR env vars are unset, the shim auto-detects the
#   canonical layout produced by `genomeclaw host setup` at
#   `/Volumes/Genome_Work/genomeclaw/{raw,reference,derived,_scratch}/`
#   and uses those paths. If neither the env vars nor the canonical
#   layout is present, the shim refuses to start with a `setup`
#   pointing message.
#
#   GENOMECLAW_NATIVE=1     Bypass Docker; invoke a locally installed
#                           genomeclaw on PATH instead. Auto-set for
#                           host-side subcommand groups (host).
#   GENOMECLAW_NO_DOCKER=1  Alias of GENOMECLAW_NATIVE=1.
#   GENOMECLAW_DEBUG=1      Print the docker invocation before running it.
#   GENOMECLAW_OFFLINE=1    Pass --network none to docker run (forbids egress).
#                           Will break `genomeclaw refs fetch`; intended for
#                           tightening privacy on local-only subcommands.
#
# Architecture: see docs/reference/architecture.md, "Host-side packaging".

set -euo pipefail

# Record the shim's own path so the natively-running Python entry point
# can re-invoke us for sub-operations that need the docker route (e.g.
# `host setup --fetch-all` post-setup hands off to `refs fetch --all`
# here so the grch38 post-fetch `samtools faidx` runs inside the toolkit
# image).
export GENOMECLAW_SHIM_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

# Subcommand routing for the `host` group:
#
#   host setup    — touches diskutil + colima; HOST-ONLY (native).
#   host doctor   — checks host filesystem + colima status; HOST-ONLY (native).
#   host eject    — `diskutil eject`; HOST-ONLY (native).
#   host service  — runs the FastAPI worker that needs bcftools / pgsc_calc /
#                   etc. — DOCKER-ONLY (worker-self-sufficient-compute
#                   Phase 3). Auto-enables DooD so docker.sock + the
#                   identical-path overlay + GENOMECLAW_HOST_ROOTS get
#                   propagated to the running service container; pgsc_calc
#                   spawns DooD siblings from inside.
#
# Pattern note: `"host service"` matches first (more specific than `"host"*`),
# so the docker path wins for the service. The remaining host subcommands
# fall through to native via `GENOMECLAW_NATIVE=1`.
case "${1:-} ${2:-}" in
  "host service")
    : "${GENOMECLAW_DOOD:=1}"
    GENOMECLAW_IS_HOST_SERVICE=1  # internal flag; consumed below to add -p 8643:8643
    ;;
  "host "*)
    : "${GENOMECLAW_NATIVE:=1}"
    ;;
esac

# Subcommands that spawn Docker-out-of-Docker (DooD) sibling containers
# from inside the toolkit container. For these, the canonical
# /mnt/genomeclaw/... mount targets are insufficient — sibling containers
# spawned by the host docker daemon must see paths at their identical
# absolute paths on the host filesystem. Phase 1 of the
# path-crossing-discipline plan adds an additive identical-path overlay
# mount when GENOMECLAW_DOOD=1.
#
# INV-D005 (Identical-Path Bind Mounts for Sibling Containers): every host
# path that may flow into a sibling's -v mount must be bind-mounted into
# this container at its identical absolute path. The gate is per-subcommand
# so non-DooD subcommands keep today's mount shape.
#
# Scan ALL positional args (skipping known global flags + their values) for
# the subcommand pair. Earlier versions checked only `$1 $2` and missed
# invocations like `genomeclaw --json pipeline prs-compute ...` (the Phase 5
# smoke driver style); the auto-DooD never fired, the docker socket wasn't
# mounted, and nextflow exited rc=1 with no diagnostic.
_dood_scan_args() {
  local prev=""
  local cur=""
  local skip_next=0
  for cur in "$@"; do
    if (( skip_next )); then
      skip_next=0
      prev="$cur"
      continue
    fi
    case "$cur" in
      # Global flags that take a value — skip the value too.
      --json|--no-json|-h|--help|--version)
        prev="$cur"
        continue
        ;;
    esac
    # DooD-spawning subcommands — those whose wrappers use
    # `as_sibling_mountable(...)` and therefore require host-form paths +
    # the identical-path overlay mount + the host-roots env var to be
    # propagated. Enforced mechanically by
    # tests/invariants/test_invD006_shim_dood_scan_exhaustive.py.
    if [[ "$prev" == "pipeline" && ( \
          "$cur" == "prs-compute" || \
          "$cur" == "prs-prepare-coverage" || \
          "$cur" == "pgs-compute" ) ]]; then
      return 0
    fi
    prev="$cur"
  done
  return 1
}

if _dood_scan_args "$@"; then
  : "${GENOMECLAW_DOOD:=1}"
fi

if [[ "${GENOMECLAW_NATIVE:-0}" == "1" || "${GENOMECLAW_NO_DOCKER:-0}" == "1" ]]; then
  # Find a `genomeclaw` on PATH that isn't this shim. If none is on
  # PATH, fall back to running it via uv from the toolkit checkout next
  # to this shim — covers the common dev case where the user has uv but
  # hasn't put the venv on PATH yet.
  shim_path="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  while IFS= read -r candidate; do
    [[ -z "$candidate" ]] && continue
    candidate_real="$(cd "$(dirname "$candidate")" && pwd)/$(basename "$candidate")"
    if [[ "$candidate_real" != "$shim_path" ]]; then
      exec "$candidate" "$@"
    fi
  done < <(type -ap genomeclaw 2>/dev/null || true)

  toolkit_dir="$(cd "$(dirname "$0")/.." && pwd)/packages/toolkit"
  if [[ -d "$toolkit_dir" ]] && command -v uv >/dev/null 2>&1; then
    cd "$toolkit_dir"
    exec uv run genomeclaw "$@"
  fi

  echo "genomeclaw: GENOMECLAW_NATIVE=1 but no non-shim genomeclaw found on PATH" >&2
  echo "  install the toolkit (cd packages/toolkit && uv sync) and put .venv/bin on PATH" >&2
  exit 127
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "genomeclaw: docker not found on PATH" >&2
  echo "  set GENOMECLAW_NATIVE=1 to run a locally installed toolkit instead" >&2
  exit 127
fi

# Auto-detect the canonical post-setup layout. The user can override any
# of the four *_DIR env vars individually; otherwise we default to the
# Genome_Work layout that `genomeclaw host setup` produces.
canonical_root="/Volumes/Genome_Work/genomeclaw"
raw_dir="${GENOMECLAW_RAW_DIR:-${canonical_root}/raw}"
ref_dir="${GENOMECLAW_REF_DIR:-${canonical_root}/reference}"
derived_dir="${GENOMECLAW_DERIVED_DIR:-${canonical_root}/derived}"
scratch_dir="${GENOMECLAW_SCRATCH_DIR:-${canonical_root}/_scratch}"

# Refuse to start unless every canonical path exists. No silent
# fallbacks, no auto-mkdir for paths the user is supposed to have set
# up via `genomeclaw host setup`.
missing=()
[[ -d "$raw_dir" ]]      || missing+=("raw_dir=$raw_dir")
[[ -d "$ref_dir" ]]      || missing+=("ref_dir=$ref_dir")
[[ -d "$derived_dir" ]]  || missing+=("derived_dir=$derived_dir")
[[ -d "$scratch_dir" ]]  || missing+=("scratch_dir=$scratch_dir")
if (( ${#missing[@]} > 0 )); then
  echo "genomeclaw: canonical mount path(s) missing:" >&2
  for m in "${missing[@]}"; do echo "  $m" >&2; done
  echo "  run \`genomeclaw host setup\` to create the canonical layout, or" >&2
  echo "  set GENOMECLAW_{RAW,REF,DERIVED,SCRATCH}_DIR to override paths" >&2
  exit 2
fi

# Sanity check: scratch and authoritative outputs must live on separate
# trees. DuckDB / bcftools-sort temp under derived/ would corrupt
# provenance-aware tooling later.
derived_real="$(cd "$derived_dir" && pwd -P)"
scratch_real="$(cd "$scratch_dir" && pwd -P)"
case "$scratch_real" in
  "$derived_real"|"$derived_real"/*)
    echo "genomeclaw: GENOMECLAW_SCRATCH_DIR ($scratch_dir) cannot be inside GENOMECLAW_DERIVED_DIR ($derived_dir)" >&2
    echo "  scratch and authoritative outputs must live on separate trees" >&2
    exit 2
    ;;
esac

# reference/ is read-only at runtime per the architecture's bind-mount
# discipline. The exception is `genomeclaw refs fetch`, the one
# user-initiated write to the reference volume — for that subcommand,
# mount RW. All other subcommands keep RO so accidental writes can't
# poison the reference tree.
ref_mount_opts="readonly"
if [[ "${1:-}" == "refs" && "${2:-}" == "fetch" ]]; then
  ref_mount_opts=""
fi

image="${GENOMECLAW_IMAGE:-genomeclaw/toolkit:dev}"
mounts=(
  "--mount" "type=bind,source=${raw_dir},target=/mnt/genomeclaw/raw,readonly"
  "--mount" "type=bind,source=${derived_dir},target=/mnt/genomeclaw/derived"
  "--mount" "type=bind,source=${scratch_dir},target=/mnt/genomeclaw/scratch"
)
if [[ -n "$ref_mount_opts" ]]; then
  mounts+=(
    "--mount" "type=bind,source=${ref_dir},target=/mnt/genomeclaw/reference,${ref_mount_opts}"
  )
else
  mounts+=("--mount" "type=bind,source=${ref_dir},target=/mnt/genomeclaw/reference")
fi

# INV-D005 — additive identical-path overlay for DooD subcommands.
#
# When the inside-container code spawns sibling containers via the host
# docker daemon (DooD), it passes host paths to those siblings' -v mount
# args. Without an identical-path overlay, the host daemon resolves those
# paths against the host filesystem where /mnt/genomeclaw/... doesn't
# exist → sibling can't see the file. The overlay mounts the host's
# canonical roots at THEIR HOST ABSOLUTE PATHS inside the toolkit
# container, so when the inside-container code references a host path it
# resolves both inside (via the overlay) and outside (via the host fs).
#
# Strategy: compute the longest common prefix of the four *_DIR paths.
# If found (canonical layout has /Volumes/Genome_Work/genomeclaw as the
# common root), mount that single path. If no common prefix above /,
# mount each of the four separately. Never mount / itself.
build_dood_overlay_mounts() {
  local p1=$1 p2=$2 p3=$3 p4=$4

  # Compute longest common prefix of four paths via shortest-pair walk.
  local common
  common=$(printf '%s\n%s\n%s\n%s\n' "$p1" "$p2" "$p3" "$p4" \
    | awk 'NR==1{c=$0; next} {
        n=length(c); while (substr($0,1,n) != c) { c=substr(c,1,n-1); n--; if (n==0) break; }
        if (n==0) { c=""; exit }
      } END {
        # Trim trailing slash for clean directory boundary.
        sub(/\/$/, "", c);
        # Ensure the common prefix is a real directory boundary, not a
        # mid-component substring (e.g., "/a/foo" and "/a/foobar" share
        # "/a/foo" textually but not as a directory).
        while (length(c) > 0 && index($0, c"/") != 1 && c != $0) c=substr(c,1,length(c)-1);
        print c;
      }')

  if [[ -n "$common" && "$common" != "/" ]]; then
    # Single overlay covers all four. RO required because raw/ is inside.
    # Subsequent RW overlays for derived/ + scratch/ + reference/ (during
    # refs fetch) layer on top; docker resolves source-first so the inner
    # RW mounts take precedence on those paths.
    printf -- "--mount\ntype=bind,source=%s,target=%s,readonly\n" "$common" "$common"
    printf -- "--mount\ntype=bind,source=%s,target=%s\n" "$p3" "$p3"  # derived RW
    printf -- "--mount\ntype=bind,source=%s,target=%s\n" "$p4" "$p4"  # scratch RW
    if [[ -z "$ref_mount_opts" ]]; then
      printf -- "--mount\ntype=bind,source=%s,target=%s\n" "$p2" "$p2"  # ref RW (refs fetch)
    fi
  else
    # No common prefix above /. Mount each separately at its identical
    # absolute path. raw + ref RO; derived + scratch RW.
    printf -- "--mount\ntype=bind,source=%s,target=%s,readonly\n" "$p1" "$p1"
    if [[ -n "$ref_mount_opts" ]]; then
      printf -- "--mount\ntype=bind,source=%s,target=%s,readonly\n" "$p2" "$p2"
    else
      printf -- "--mount\ntype=bind,source=%s,target=%s\n" "$p2" "$p2"
    fi
    printf -- "--mount\ntype=bind,source=%s,target=%s\n" "$p3" "$p3"
    printf -- "--mount\ntype=bind,source=%s,target=%s\n" "$p4" "$p4"
  fi
}

dood_env_args=()
dood_socket_mounts=()
if [[ "${GENOMECLAW_DOOD:-0}" == "1" ]]; then
  while IFS= read -r line; do
    [[ -n "$line" ]] && mounts+=("$line")
  done < <(build_dood_overlay_mounts "$raw_dir" "$ref_dir" "$derived_dir" "$scratch_dir")

  # INV-D006 — make the deployment's host roots visible to as_sibling_mountable.
  #
  # The inside-container factory _paths.as_sibling_mountable validates a path
  # against the colon-separated GENOMECLAW_HOST_ROOTS env var. Without it, a
  # path under the deployment's actual host root (e.g., /Volumes/Genome_Work/
  # genomeclaw/...) gets rejected even though the Phase-1 overlay made it
  # visible. Surface every canonical *_DIR root so the factory accepts paths
  # under any of them.
  dood_host_roots="${raw_dir}:${ref_dir}:${derived_dir}:${scratch_dir}"
  dood_env_args+=("--env" "GENOMECLAW_HOST_ROOTS=${dood_host_roots}")

  # Phase 6 INV-D006 tightening — publish per-subdir mappings.
  #
  # The factory rejects canonical-mount paths (/mnt/genomeclaw/<sub>/...)
  # with a translated hint naming the host-form equivalent. The translation
  # table comes from these four env vars; threading them lets the inside-
  # container error message say "use ${GENOMECLAW_SCRATCH_DIR}/foo instead"
  # with the real host-side path filled in.
  dood_env_args+=("--env" "GENOMECLAW_RAW_DIR=${raw_dir}")
  dood_env_args+=("--env" "GENOMECLAW_REF_DIR=${ref_dir}")
  dood_env_args+=("--env" "GENOMECLAW_DERIVED_DIR=${derived_dir}")
  dood_env_args+=("--env" "GENOMECLAW_SCRATCH_DIR=${scratch_dir}")

  # INV-D005 corollary — bind-mount the host docker socket so the inside-
  # container Nextflow / pgsc_calc orchestrator can spawn sibling containers
  # via the host daemon (DooD). Phase 5 smoke 2026-05-19 surfaced this: the
  # pre-discipline smoke driver bypassed the shim with its own
  # `--user 0:0 -v /var/run/docker.sock:...` because the shim had never
  # mounted the socket. Phase 1 added the path overlay but left the
  # socket gap.
  dood_socket_mounts+=("--mount" "type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock")
fi

uid="$(id -u)"
gid="$(id -g)"

# DooD subcommands need write access to /var/run/docker.sock. The socket
# inside the toolkit container is owned by `root` + the engine VM's docker
# group (e.g., GID 991 on colima, 999 on most Linux distros, varying on
# others). Matching the group inside the container reliably requires knowing
# the engine's GID at runtime — the cleanest portable answer is `--user 0:0`
# for DooD subcommands, which always has socket access. The trade-off is
# that files the toolkit writes during a DooD run land root-owned on the
# host; this surfaces on the host as files under `_scratch/` and `derived/`
# the user must clean with `sudo rm`. Power users on strict-permission
# environments can override with GENOMECLAW_DOOD_USER=<uid:gid> to keep
# host-side ownership (provided they ensure socket-group membership).
# Phase 5 smoke 2026-05-19 surfaced the original default ${uid}:${gid}
# silently failing with `permission denied` on the socket and an empty
# nextflow stderr.
if [[ "${GENOMECLAW_DOOD:-0}" == "1" ]]; then
  dood_user="${GENOMECLAW_DOOD_USER:-0:0}"
else
  dood_user="${uid}:${gid}"
fi

network_args=()
if [[ "${GENOMECLAW_OFFLINE:-0}" == "1" ]]; then
  network_args+=("--network" "none")
fi

# Pseudo-TTY allocation. Off-TTY (CI / pipes / agents calling us
# programmatically), the containerised CLI sees ``sys.stdout.isatty()
# == False`` and rich's ``Live`` renderer (which drives ``Progress``)
# silently disables itself — the user sees no progress bars at all.
# Allocate ``-t`` when stdout IS a TTY so rich-mode progress renders
# correctly. Keep it off otherwise — pipes + agents want clean
# unbuffered bytes, not terminal control sequences.
#
# Override with GENOMECLAW_FORCE_TTY=1 / GENOMECLAW_NO_TTY=1 for tests
# / CI smoke runs that explicitly want a different shape.
tty_args=()
if [[ "${GENOMECLAW_FORCE_TTY:-0}" == "1" ]] || { [[ "${GENOMECLAW_NO_TTY:-0}" != "1" ]] && [[ -t 1 ]]; }; then
  tty_args+=("-t")
fi

# prs-smoke-resilience Phase 2.2 — label the spawned container with the
# smoke's run-id so the smoke driver's EXIT trap can find + clean up
# leftover toolkit + sibling containers from this run. Closes the
# v22e + v22g zombie pattern (Nextflow siblings outliving the parent).
# Smoke driver exports GENOMECLAW_SMOKE_RUN_ID before invoking the shim;
# the shim threads it through; cleanup pass filters by label.
smoke_label_args=()
if [[ -n "${GENOMECLAW_SMOKE_RUN_ID:-}" ]]; then
  smoke_label_args+=("--label" "genomeclaw-smoke=${GENOMECLAW_SMOKE_RUN_ID}")
fi

# `host service` lives in the toolkit container per Phase 3 of
# worker-self-sufficient-compute. Publish the bind port (default 8643;
# operator override via GENOMECLAW_HOST_SERVICE_PORT) so the sandbox can
# reach the container's uvicorn via host.openshell.internal:<port>.
# Uvicorn must bind 0.0.0.0 inside the container for the docker-NAT
# bridge to forward inbound connections; the canonical CLI default of
# 127.0.0.1 only accepts container-local traffic, so we append --host
# 0.0.0.0 to the argv if the operator didn't already supply --host.
host_service_args=()
host_service_extra_argv=()
if [[ "${GENOMECLAW_IS_HOST_SERVICE:-0}" == "1" ]]; then
  service_port="${GENOMECLAW_HOST_SERVICE_PORT:-8643}"
  host_service_args+=("--publish" "${service_port}:${service_port}")
  # Append --host 0.0.0.0 only if operator didn't already pass --host.
  has_host_flag=0
  for arg in "$@"; do
    if [[ "$arg" == "--host" || "$arg" == --host=* ]]; then
      has_host_flag=1
      break
    fi
  done
  if (( has_host_flag == 0 )); then
    host_service_extra_argv+=("--host" "0.0.0.0")
  fi
fi

cmd=(
  docker run --rm
  --user "${dood_user}"
  ${tty_args[@]+"${tty_args[@]}"}
  ${network_args[@]+"${network_args[@]}"}
  ${dood_env_args[@]+"${dood_env_args[@]}"}
  ${dood_socket_mounts[@]+"${dood_socket_mounts[@]}"}
  ${mounts[@]+"${mounts[@]}"}
  ${smoke_label_args[@]+"${smoke_label_args[@]}"}
  ${host_service_args[@]+"${host_service_args[@]}"}
  "$image"
  genomeclaw
  "$@"
  ${host_service_extra_argv[@]+"${host_service_extra_argv[@]}"}
)

if [[ "${GENOMECLAW_DEBUG:-0}" == "1" ]]; then
  printf 'genomeclaw:' >&2
  printf ' %q' "${cmd[@]}" >&2
  printf '\n' >&2
fi

exec "${cmd[@]}"
